# Keep the PUID/PGID and public URL from your existing LinuxServer container.
PUID=1000
PGID=1000
TZ=Etc/UTC
HTTP_PORT=8080
HTTPS_PORT=8443
APP_URL=https://files.example.com
UPLOAD_MAX_BYTES=21474836480
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls = STARTTLS (587), ssl = implicit TLS (465), none = local test server only.
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=files@example.com
SMTP_FROM_NAME=XBackBone
OIDC_ENABLED=false
# Authentik's per-application issuer, including the trailing slash:
OIDC_ISSUER=https://auth.example.com/application/o/xbackbone/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTO_REGISTER=false
