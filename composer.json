{
  "name": "sergix44/xbackbone",
  "license": "AGPL-3.0-only",
  "version": "3.8.2",
  "description": "A lightweight ShareX PHP backend",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "erusev/parsedown": "^1.7",
    "intervention/image": "^2.6",
    "league/flysystem": "^3.30",
    "league/flysystem-aws-s3-v3": "^3.30",
    "maennchen/zipstream-php": "^2.0",
    "monolog/monolog": "^3.9",
    "php-di/slim-bridge": "^3.0",
    "sapphirecat/slim4-http-interop-adapter": "^1.0",
    "slim/psr7": "^1.5",
    "slim/slim": "^4.0",
    "spatie/flysystem-dropbox": "^3.0",
    "twig/twig": "^3.11",
    "jumbojett/openid-connect-php": "^1.0.2",
    "symfony/mailer": "^7.4",
    "league/flysystem-local": "^3.30",
    "league/flysystem-ftp": "^3.30",
    "league/flysystem-google-cloud-storage": "^3.30",
    "league/flysystem-azure-blob-storage": "^3.30"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.5.12"
    }
  },
  "autoload": {
    "files": [
      "app/helpers.php"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/dom-crawler": "^7.4"
  }
}
